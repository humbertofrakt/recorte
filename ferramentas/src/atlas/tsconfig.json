{
  "//": "Compila ferramentas/src/atlas para ferramentas/dist/atlas, para os scripts .mjs da linha de comando importarem. O editor importa o .ts direto.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "rootDir": ".",
    "outDir": "../../dist/atlas",
    "types": []
  },
  "include": ["./*.ts"]
}
