    { "name": "root" },
    { "name": "rabo",       "parent": "quadril", "x": -6, "y": 0, "rotation": -120, "length": 40, "skinRequired": true, "color": [0.55, 0.4, 0.25, 1] },
    { "name": "rabo_ponta", "parent": "rabo",    "x": 40, "y": 0, "rotation": 20,   "length": 30, "skinRequired": true, "color": [0.55, 0.4, 0.25, 1] }
  ],

  "slots": [
    { "name": "rabo",       "bone": "rabo",       "attachment": "rabo" },
